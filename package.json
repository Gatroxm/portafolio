{
  "name": "gabriel-troncoso-portfolio",
  "version": "1.0.0",
  "description": "Portafolio profesional de Gabriel Troncoso - Desarrollador Full Stack con proyectos destacados",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "serve": "vite preview --port 3000",
    "deploy:aws": "npm run build && aws s3 sync dist/ s3://your-bucket-name --delete",

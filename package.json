    "deploy:vercel": "npm run build && vercel --prod"
  },
  "dependencies": {
    "vue": "^3.3.0",
    "vue-router": "^4.2.0",
    "@heroicons/vue": "^2.0.0",
    "aos": "^2.3.4"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^4.4.0",
    "autoprefixer": "^10.4.15",
    "postcss": "^8.4.29",
    "tailwindcss": "^3.3.0",
    "vite": "^4.4.0"
  }
}